# --- Required for AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TRIAGE_MODEL=gemini-3.8-flash
GEMINI_RESEARCH_MODEL=gemini-3.8-flash

# --- Required for Discord Bot (can be left empty to run dashboard-only during testing) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INBOX_CHANNEL_ID=
ALLOWED_DISCORD_USER_ID=

# --- Web Dashboard & Security ---
PORT=3000
APP_BASE_URL=http://localhost:3000
DASHBOARD_PASSWORD=changeme123
SESSION_SECRET=change_this_to_a_long_random_secret_string

# --- Scheduler & Localization ---
TIMEZONE=Europe/Warsaw
DAILY_DIGEST_CRON=30 8 * * *
DATA_DIR=./data

# --- Assisted Checkout (Phase 1.5: Cart + Shipping Prep, Manual Payment) ---
CHECKOUT_ENABLED=true
CHECKOUT_MAX_AMOUNT_PLN=500

# --- Google Calendar ("Dom" via Service Account) ---
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_NAME=Dom
GOOGLE_SERVICE_ACCOUNT_PATH=./data/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
